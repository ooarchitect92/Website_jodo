{
  "name": "website-jodo",
  "version": "0.1.0",
  "private": true,
  "description": "Jodo reference recreation and blueprint-driven owner CMS",
  "engines": {
    "node": ">=22.16.0 <23 || >=24 <25"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "tsx --env-file=.env scripts/doctor.ts",
    "dev": "concurrently -k -n web,api,worker \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:web": "node scripts/next.mjs dev apps/web --webpack -p 3000",
    "dev:api": "tsx --env-file=.env --tsconfig tsconfig.api.json watch apps/api/src/main.ts",
    "dev:worker": "tsx --env-file=.env --tsconfig tsconfig.api.json watch apps/worker/src/main.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "node scripts/next.mjs build apps/web --webpack",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env --tsconfig tsconfig.api.json --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed.ts",
    "create:owner": "tsx --env-file=.env scripts/create-owner.ts",
    "start:api": "node --env-file=.env dist/apps/api/src/main.js",
    "start:worker": "node --env-file=.env dist/apps/worker/src/main.js",
    "start:web": "node scripts/next.mjs start apps/web -p 3000",
    "start:prod": "concurrently -k -n web,api,worker \"npm:start:web\" \"npm:start:api\" \"npm:start:worker\"",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore:verify": "node --env-file=.env scripts/restore-verify.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "next": "16.4.0",
    "nodemailer": "10.0.15",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.4",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
