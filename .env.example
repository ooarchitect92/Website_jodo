# Run npm run bootstrap to create .env with new random local secrets.
# Never use example values in a production deployment.
DEPLOYMENT_MODE=demo
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
DATABASE_URL=postgresql://jodo_app:CHANGE_ME@127.0.0.1:5432/website_jodo
MIGRATION_DATABASE_URL=postgresql://jodo_owner:CHANGE_ME@127.0.0.1:5432/website_jodo
POSTGRES_DB=website_jodo
POSTGRES_USER=jodo_owner
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_USER=jodo_app
APP_DB_PASSWORD=CHANGE_ME
SESSION_SECRET=GENERATE_64_HEX_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
# Only fixed, reviewed reverse-proxy subnets. Empty = trust no proxy headers.
TRUSTED_PROXY_CIDRS=
MEDIA_DIRECTORY=.data/media
# All optional outbound integrations are disabled until configured and tested.
NOTIFICATION_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_TO=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_ALLOWED_HOSTS=
AUDIT_EXPORT_DIRECTORY=.data/audit-export
# This is a local evidence copy, NOT independent WORM storage.
AUDIT_CHECKPOINT_SECRET=GENERATE_64_HEX_CHARACTERS
BLOG_AUTO_DELETE_ENABLED=false
SITE_APPROVED=false
PUBLIC_INDEXING_ENABLED=false
PRIVACY_POLICY_VERSION=2026-10-v1
